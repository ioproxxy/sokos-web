# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAFARICOM M-PESA DARAJA INTEGRATION KEYS
# Configure these on your VPS to trigger real handset SIM PIN prompts!
MPESA_ENV="sandbox" # Use 'sandbox' or 'production'
MPESA_CONSUMER_KEY="YOUR_DARAJA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_DARAJA_CONSUMER_SECRET"
MPESA_SHORTCODE="174379" # Your till number or paybill shortcode (sandbox uses 174379)
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919" # Lipa Na Mpesa Passkey
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline" # or CustomerBuyGoodsOnline for Till numbers
MPESA_CALLBACK_URL="https://yourdomain.com/api/mpesa/callback" # your external https callback URL

# POSTGRES DATABASE URL FOR VPS DEPLOYMENT
DATABASE_URL="postgresql://sahoo_user:Atana12%40.%23@localhost:5432/sahoo"

# JWT SECRET FOR OAUTH SESSION TOKENS
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-change-in-production"

# GOOGLE OAUTH (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web application)
# Add authorized redirect URIs: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"


